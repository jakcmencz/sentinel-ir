{
  "name": "sentinel-ir",
  "version": "0.2.1",
  "description": "Structural IR for AI reasoning over code: turns JavaScript and TypeScript into compact tree-sitter facts for an LLM instead of the raw file",
  "main": "src/sentinel-ir.js",
  "files": [
    "src/sentinel-ir.js",
    "src/ast-facts.js",
    "src/tree-parser.js",
    "examples/basic.js",
    "wasm/tree-sitter-javascript.wasm",
    "wasm/tree-sitter-typescript.wasm",
    "wasm/tree-sitter-tsx.wasm",
    "wasm/LICENSE-tree-sitter-typescript",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "example": "node examples/basic.js"
  },
  "keywords": [
    "llm",
    "ai",
    "intermediate-representation",
    "ir",
    "tree-sitter",
    "ast",
    "javascript",
    "typescript",
    "tsx",
    "static-analysis",
    "code-analysis",
    "prompt",
    "token-savings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/jakubrojicek11/sentinel-ir.git"
  },
  "homepage": "https://gitlab.com/jakubrojicek11/sentinel-ir#readme",
  "bugs": {
    "url": "https://gitlab.com/jakubrojicek11/sentinel-ir/-/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-tree-sitter": "^0.25.10"
  },
  "optionalDependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4"
  }
}
